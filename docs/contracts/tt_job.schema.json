{
  "type": "object",
  "required": ["job_id", "created_at", "calls"],
  "properties": {
    "job_id":     { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "args", "expect"],
        "properties": {
          "tool":   { "type": "string" },
          "args":   { "type": "object" },
          "expect": { "enum": ["numbers", "rate", "text"] }
        }
      }
    }
  }
}
