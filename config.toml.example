# ==============================================
# Anaphase-Helix Configuration Template
# Copy this file to config.toml and fill in your values.
# ==============================================

[anaphase]
# Service endpoints for external components
# Empty value = Auto-use Noop adapter (offline mode)
mind_endpoint = ""
flowmodus_endpoint = ""
tentacle_endpoint = ""
tuck_endpoint = ""
callosum_endpoint = ""
cellrix_endpoint = ""

# HTTP CAP server for remote debugging
cap_http_enabled = false
cap_http_port = 50061

# ---- Reasoning Adapter (OpenAI-compatible API) ----
# Uncomment and fill these lines to use a real LLM endpoint.
# reasoning_endpoint = "http://your-llm-host:port/v1"
# reasoning_model = "your-model-name"
# reasoning_api_key = "sk-your-api-key"
# reasoning_max_tokens = 2048

[cognitive]
# AI Model configuration for cognitive modules
amygdala_model = "qwen2.5:2b"
left_brain_model = "qwen2.5-coder:7b"
right_brain_model = "deepseek-r1:8b"
cerebellum_model = "qwen2.5:2b"
embedding_model = "BAAI/bge-small-en"

[immune]
# Immune system & reflex safety settings
hard_reflex_enabled = true
soft_reflex_threshold_intercept = 0.7
soft_reflex_threshold_warn = 0.3
inherit_safety_rules = false
