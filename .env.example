# Tuck Gateway Configuration
TUCK_ENDPOINT=http://localhost:8686
TUCK_API_KEY=local

# Helix-Mind Service Configuration
HELIX_MIND_ENDPOINT=http://localhost:8020

# Model Configuration
ANA_AMYGDALA_MODEL=qwen2.5:2b
ANA_LEFT_BRAIN_MODEL=qwen2.5-coder:7b
ANA_RIGHT_BRAIN_MODEL=deepseek-r1:8b
ANA_CEREBELLUM_MODEL=qwen2.5:2b
ANA_EMBEDDING_MODEL=BAAI/bge-small-en

# Path Configuration
ANA_HXR_DIR=./memory_dag/sessions
ANA_GENE_LOCK_PATH=./config/gene_lock.md

# Logging
ANA_LOG_LEVEL=INFO

# Feature Flags
ANA_MOCK_MODE=false
ANA_ENABLE_AFFECT=true
# AI Coder Safety Flags
ANA_DISABLE_AUTO_WEB_SEARCH=false
ANA_ENFORCE_TOOL_VALIDATION=true
ANA_MAX_AUTO_CORRECTION_ROUNDS=3

# Metabolism Thresholds
ANA_FATIGUE_LINE=0.8
ANA_APOPTOSIS_LINE=0.95
ANA_MAX_LOOPS=20
